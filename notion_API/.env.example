# ==============================================================================
# Silent Onboarding — External Integrations & Notion Configuration
# ==============================================================================

# Notion Integration Secret Token (from https://www.notion.so/my-integrations)
# e.g., secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_API_KEY=your_notion_integration_secret_here

# Notion Target Page ID or Full Notion Page URL
# (e.g. 1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d or 1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d)
NOTION_PAGE_ID=your_notion_page_id_here

# Optional: SkillPatch API Key (for external LLM acceleration)
SKILLPATCH_API_KEY=

# Optional: LLM Keys (OpenAI / Gemini for LLM-assisted doc polishing)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Webhook Service Port (for Member 2 Discord Bot webhook trigger)
PORT=8000
